`timescale 1ns / 1ps

// ============================================================================
// Xilinx Simulation Models for iverilog
// Replacements for Vivado primitives and IP used in fpga_ssc_pll_top.v
// ============================================================================

// ----------------------------------------------------------------------------
// IBUFDS: Differential input → single-ended
// In simulation, simply pass the positive input through.
// ----------------------------------------------------------------------------
module IBUFDS #(
    parameter DIFF_TERM    = "FALSE",
    parameter IBUF_LOW_PWR = "TRUE",
    parameter IOSTANDARD   = "DEFAULT"
) (
    output O,
    input  I,
    input  IB
);
    assign O = I;
endmodule

// ----------------------------------------------------------------------------
// OBUFDS: Single-ended → differential output
// In simulation, drive both outputs from input.
// ----------------------------------------------------------------------------
module OBUFDS #(
    parameter IOSTANDARD = "DEFAULT",
    parameter SLEW       = "SLOW"
) (
    output O,
    output OB,
    input  I
);
    assign O  = I;
    assign OB = ~I;
endmodule

// ----------------------------------------------------------------------------
// BUFG: Global clock buffer
// In simulation, pass through (zero delay).
// ----------------------------------------------------------------------------
module BUFG (
    output O,
    input  I
);
    assign O = I;
endmodule

// ----------------------------------------------------------------------------
// BUFGMUX: Global clock mux with synchronous select
// Simple mux for simulation.
// ----------------------------------------------------------------------------
module BUFGMUX #(
    parameter CLK_SEL_TYPE = "SYNC"
) (
    output O,
    input  I0,
    input  I1,
    input  S
);
    assign O = S ? I1 : I0;
endmodule

// ============================================================================
// VIO IP Stubs — probe outputs drive reasonable default values for sim
// ============================================================================

// ----------------------------------------------------------------------------
// vio_0: Main VIO
//   probe_in0[0:0]  - idelay_rdy
//   probe_in1[0:0]  - locked_pll
//   probe_out0[7:0] - int_div          ← default 71
//   probe_out1[9:0] - frac             ← default 213
//   probe_out2[9:0] - dtc_gain         ← default 200 (rough gain)
//   probe_out3[2:0] - dtc_en           ← default 1
//   probe_out4[9:0] - ref_div_cnt_cmp  ← default 12 (for div by 12.5)
//   probe_out5[8:0] - dtc_offset       ← default 0
//   probe_out6[0:0] - cal_mode         ← default 0
// ----------------------------------------------------------------------------
module vio_0 (
    input         clk,
    input  [0:0]  probe_in0,
    input  [0:0]  probe_in1,
    output [7:0]  probe_out0,
    output [9:0]  probe_out1,
    output [9:0]  probe_out2,
    output [2:0]  probe_out3,
    output [9:0]  probe_out4,
    output [8:0]  probe_out5,
    output [0:0]  probe_out6
);
    assign probe_out0 = 8'd71;       // int_div
    assign probe_out1 = 10'd213;     // frac
    assign probe_out2 = 10'd200;     // dtc_gain
    assign probe_out3 = 3'd1;        // dtc_en
    assign probe_out4 = 10'd12;      // ref_div_cnt_cmp
    assign probe_out5 = 9'd0;        // dtc_offset
    assign probe_out6 = 1'd0;        // cal_mode
endmodule

// ----------------------------------------------------------------------------
// vio_cal: Calibration VIO (missing IP from project — created for sim)
//   probe_out0 - cal_start    ← pulse 0
//   probe_out1 - cal_auto_en  ← 0 (manual)
//   probe_out2 - order_sel    ← 0 (1st order)
//   probe_in0[9:0]  - dtc_gain_cal
//   probe_in1[0:0]  - cal_done
// ----------------------------------------------------------------------------
module vio_cal (
    input         clk,
    output        probe_out0,
    output        probe_out1,
    output        probe_out2,
    input  [9:0]  probe_in0,
    input  [0:0]  probe_in1
);
    reg [7:0] cnt = 0;
    reg cal_start_r = 0;
    assign probe_out0 = cal_start_r;
    assign probe_out1 = 1'b0;   // manual mode
    assign probe_out2 = 1'b0;   // 1st order

    // Trigger calibration once after startup
    always @(posedge clk) begin
        if (cnt < 8'd100) cnt <= cnt + 1;
        else if (cnt == 8'd100) begin
            cal_start_r <= 1'b1;
            cnt <= cnt + 1;
        end else if (cnt == 8'd101) begin
            cal_start_r <= 1'b0;
            cnt <= cnt + 1;
        end
    end
endmodule

// ----------------------------------------------------------------------------
// vio_rst: Reset control VIO
//   probe_out0[0:0] - rst_n_fracn  ← 1 (not in reset)
//   probe_out1[0:0] - ssc_bp       ← 1 (bypass SSC)
//   probe_out2[0:0] - rst_n_dtc    ← 1 (not in reset)
//   probe_out3[0:0] - dtc_sel      ← 0
// ----------------------------------------------------------------------------
module vio_rst (
    input         clk,
    output [0:0]  probe_out0,
    output [0:0]  probe_out1,
    output [0:0]  probe_out2,
    output [0:0]  probe_out3
);
    assign probe_out0 = 1'b1;
    assign probe_out1 = 1'b1;   // SSC bypass ON for sim
    assign probe_out2 = 1'b1;
    assign probe_out3 = 1'b0;
endmodule

// ----------------------------------------------------------------------------
// vio_1: Additional VIO used in dtc_comp
//   probe_out0[0:0] - dtc_code_man_en
//   probe_out1[9:0] - dtc_code_man
// ----------------------------------------------------------------------------
module vio_1 (
    input         clk,
    output [0:0]  probe_out0,
    output [9:0]  probe_out1
);
    assign probe_out0 = 1'b0;   // manual code disabled
    assign probe_out1 = 10'd0;
endmodule

// ----------------------------------------------------------------------------
// vio_eo: Eo delay select VIO (used in fractionaln)
//   probe_out0[1:0] - eo_dly_sel
// ----------------------------------------------------------------------------
module vio_eo (
    input         clk,
    output [1:0]  probe_out0
);
    assign probe_out0 = 2'd0;
endmodule

// ----------------------------------------------------------------------------
// test_clk: Clock debug mux select VIO
//   probe_out0[2:0] - clk_sel_0  ← 0
//   probe_out1[2:0] - clk_sel_1  ← 0
// ----------------------------------------------------------------------------
module test_clk (
    input         clk,
    output [2:0]  probe_out0,
    output [2:0]  probe_out1
);
    assign probe_out0 = 3'd0;
    assign probe_out1 = 3'd0;
endmodule

// ============================================================================
// ILA IP Stubs — no-op for simulation
// ============================================================================
module ila_0 (
    input         clk,
    input  [0:0]  probe0,
    input  [0:0]  probe1,
    input  [9:0]  probe2,
    input  [2:0]  probe3,
    input  [8:0]  probe4,
    input  [8:0]  probe5,
    input  [0:0]  probe6
);
    // stub — no contents
endmodule

module ila_1 (
    input         clk,
    input  [9:0]  probe0,
    input  [9:0]  probe1,
    input  [9:0]  probe2,
    input  [9:0]  probe3,
    input  [3:0]  probe4
);
    // stub — no contents
endmodule

module ila_dualdiv (
    input         clk,
    input  [5:0]  probe0,
    input  [1:0]  probe1,
    input  [1:0]  probe2,
    input  [1:0]  probe3,
    input  [3:0]  probe4,
    input  [0:0]  probe5
);
    // stub — no contents
endmodule

// ============================================================================
// mash_stage: MASH stage used in fractionaln/mash111.v
// ----------------------------------------------------------------------------
module mash_stage (
    input         clk,
    input         rst_n,
    input         clr,
    input         en,
    input         di,
    output        do,
    output [9:0]  eo
);
    // stub — no contents
    assign do = 1'b0;
    assign eo = 10'd0;
endmodule

// ============================================================================
// clk_wiz_0: MMCM PLL Behavioral Model
//   Input:  clk_in1 = 12.5MHz (period 80ns from div10 of 125MHz sys_clk)
//   Output: clk_out1 = 625MHz (period 1.6ns, 75% duty cycle)
// ============================================================================
module clk_wiz_0 (
    input         clkfb_in,
    output        clk_out1,
    output        clkfb_out,
    input         reset,
    output        locked,
    input         clk_in1
);
    reg clk_out_r = 0;
    reg locked_r = 0;
    reg [15:0] lock_cnt = 0;

    // 625MHz with 75% duty: high 1.2ns, low 0.4ns → period 1.6ns
    always begin
        #1.2 clk_out_r = 1;
        #0.4 clk_out_r = 0;
    end

    // Lock simulation: count ~100 input clock cycles (~8us)
    always @(posedge clk_in1 or posedge reset) begin
        if (reset) begin
            lock_cnt <= 0;
            locked_r <= 0;
        end else if (!locked_r) begin
            if (lock_cnt < 16'd8000) lock_cnt <= lock_cnt + 1;
            else locked_r <= 1;
        end
    end

    assign clk_out1 = clk_out_r;
    assign clkfb_out = clk_out_r;
    assign locked = locked_r;
endmodule
